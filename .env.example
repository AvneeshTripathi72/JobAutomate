# ─────────────────────────────────────────────────────────────────────────────
# Tilcons — Environment Variables
# Copy this file to .env and fill in real values.
# .env is git-ignored. This file (.env.example) is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# PostgreSQL connection string.
# Free option: sign up at https://neon.tech → create a project → copy the
# connection string. It should include ?sslmode=require at the end.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Session (REQUIRED) ────────────────────────────────────────────────────────
# A random, secret string used to sign session cookies.
# Generate one: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ── App URL (recommended) ─────────────────────────────────────────────────────
# The public URL of your deployed site. Used to build password-reset email links.
# Example: https://tilcons.onrender.com  or  https://tilcons.com
APP_URL=https://your-app-url.com

# ── Node Environment ─────────────────────────────────────────────────────────
# Set to "production" on your server. Do NOT set to "development" in production.
NODE_ENV=production

# ── SMTP Email (optional) ────────────────────────────────────────────────────
# Needed for: resume submission notifications, job application alerts,
# contact form emails, and candidate password-reset emails.
# Without SMTP, the app still works — emails just won't be sent.
#
# If you have Bluehost hosting, you can use your cPanel email account:
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587
#   SMTP_USER=noreply@yourdomain.com
#   SMTP_PASS=your-cpanel-email-password
#   SMTP_FROM="Tilcons <noreply@yourdomain.com>"
#   SMTP_SECURE=false
#
# For Gmail (with App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=your-gmail-app-password
#   SMTP_FROM="Tilcons <your@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# ── OpenAI / AI Features (optional) ─────────────────────────────────────────
# Needed for: AI Resume Screening, JD-to-Test Generator, Agastya chatbot.
# Without these, AI features show an error but all other features work normally.
# Get a key at: https://platform.openai.com/api-keys
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Microsoft Graph / Outlook (optional, legacy) ────────────────────────────
# Previously used for email. Now replaced by SMTP above.
# Leave blank unless you specifically need Outlook integration.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=

# ── Port (optional) ───────────────────────────────────────────────────────────
# The port the server listens on. Render/Railway set this automatically.
# Defaults to 5000 if not set.
# PORT=5000
